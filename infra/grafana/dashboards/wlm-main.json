        "enable": true,
        "iconColor": "red",
        "name": "Ground-truth events",
        "rawQuery": true,
        "target": {
          "format": "table",
          "rawSql": "SELECT start_time AS time, end_time AS \"timeEnd\", event_type || COALESCE(CASE WHEN params->>'subtype' IS DISTINCT FROM event_type THEN ' / ' || (params->>'subtype') END, '') AS text, event_type AS tags FROM ground_truth_events WHERE device_id = '${device}' AND start_time <= $__timeTo() AND end_time >= $__timeFrom() ORDER BY start_time",
          "refId": "Annotations"
        },
        "type": "dashboard"
      }
    ]
  },
